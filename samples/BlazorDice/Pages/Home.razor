@page "/"
@inject IDice Dice

<PageTitle>Dice Roller</PageTitle>

<h1>Visual Dice Roller</h1>

<p>
    This page uses the public component exactly as a consuming application would. The
    application parses the notation and rolls the dice, then hands the finished result to
    the component to animate.
</p>

<div class="mb-3 d-flex gap-2 align-items-center">
    <input class="form-control" style="max-width: 12rem;" @bind="_notation" aria-label="Dice notation" />
    <button class="btn btn-primary" @onclick="RollAsync" disabled="@_isRolling">Roll</button>
    <button class="btn btn-secondary" @onclick="ReplayAsync" disabled="@(_isRolling || _result is null)">Replay</button>
    <label class="form-check-label ms-3">
        <input type="checkbox" class="form-check-input" @bind="_reducedMotion" /> Reduced motion
    </label>
    <select class="form-select ms-3" style="max-width: 12rem;" aria-label="Theme" @bind="_themeName">
        @foreach (var theme in Themes)
        {
            <option value="@theme.Name">@theme.Name</option>
        }
    </select>
</div>

<div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
    <span class="text-muted">Examples:</span>
    @foreach (var sample in Samples)
    {
        <button class="btn btn-outline-secondary btn-sm"
                @onclick="@(() => UseSample(sample.Notation))"
                disabled="@_isRolling"
                title="@sample.Description">
            @sample.Notation
        </button>
    }
</div>

<div style="max-width: 40rem;">
    <VisualDiceRoller @ref="_roller"
                      Result="_result"
                      Options="@(DiceRollerOptions.Default with { Theme = SelectedTheme, ReducedMotion = _reducedMotion })"
                      OnRollCompleted="OnCompleted"
                      OnRollFailed="OnFailed" />
</div>

@if (_error is not null)
{
    <p class="text-danger mt-3">@_error</p>
}
else if (_summary is not null)
{
    <p class="mt-3">
        <strong>@_summary.Expression</strong> = @_summary.Total
        (@string.Join(", ", _summary.Dice.Select(d => d.Value)))
    </p>
}

@code {
    private static readonly DiceTheme[] Themes =
    [
        DiceTheme.Default,
        DiceTheme.DarkFantasy,
        DiceTheme.Parchment,
    ];

    private static readonly (string Notation, string Description)[] Samples =
    [
        ("4d6k3+2", "Ability score roll keeping the highest three dice"),
        ("1d20+5", "Single attack roll with a modifier"),
        ("2d6+1d8+1d4", "Mixed die types in one roll"),
        ("1d2", "Coin flip"),
        ("3d100", "Percentile dice"),
        ("2d6++", "Invalid notation, shows the error path"),
    ];

    private VisualDiceRoller? _roller;
    private DiceResult? _result;
    private DiceRollSummary? _summary;
    private string _notation = "4d6k3+2";
    private string? _error;
    private bool _reducedMotion;
    private bool _isRolling;
    private string _themeName = DiceTheme.Default.Name;

    private DiceTheme SelectedTheme =>
        Themes.FirstOrDefault(t => t.Name == _themeName) ?? DiceTheme.Default;

    private void UseSample(string notation)
    {
        _notation = notation;
        RollAsync();
    }

    private void RollAsync()
    {
        _error = null;
        _summary = null;
        _isRolling = true;

        var result = Dice.Roll(_notation);
        if (result.HasError)
        {
            _error = result.Error;
            _isRolling = false;
            return;
        }

        _result = result;
    }

    private async Task ReplayAsync()
    {
        if (_roller is null) return;

        _isRolling = true;
        await _roller.ReplayAsync();
    }

    private void OnCompleted(DiceRollSummary summary)
    {
        _summary = summary;
        _isRolling = false;
    }

    private void OnFailed(Exception exception)
    {
        _error = $"The animation failed: {exception.Message}";
        _isRolling = false;
    }
}
