<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Dice Cli</Title>
    <Description>A command-line to to roll dice randomly. You can specify which dice to roll using the common dice notation used by roleplaying games (like Dungeons &amp; Dragons). For example 3d6+1, rolls with three 6-sided dice, adds the results, and adds a bonus of 1.</Description>
    <PackageTags>dice; dice rolls; rolling dice; dice notation; random generation</PackageTags>
    <PackageReleaseNotes>Initial version with ability to roll dice based on known dice notation.</PackageReleaseNotes>
    <PackAsTool>True</PackAsTool>
    <ToolCommandName>dice-cli</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Functional" />
    <PackageReference Include="D20Tek.Spectre.Console.Extensions" />
    <PackageReference Include="LowDb.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\d20Tek.DiceNotation\d20Tek.DiceNotation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\package-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
